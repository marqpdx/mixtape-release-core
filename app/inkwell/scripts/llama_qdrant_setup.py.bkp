# Get the absolute path to the current script (llama_qdrant_setup.py)
SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))

# Build the path to the model
MODEL_PATH = os.path.join(SCRIPT_DIR, "..", "models", "llama-2-7b.Q5_K_S.gguf")

# Normalize the path
MODEL_PATH = os.path.normpath(MODEL_PATH)

# 0 Load Local Embedding Model
Settings.embed_model = HuggingFaceEmbedding(model_name="BAAI/bge-base-en") # Change model as needed

# 1️ Setup Qdrant Vector DB (Run Qdrant Locally First: `docker run -p 6333:6333 qdrant/qdrant`)
qdrant_client = QdrantClient("http://localhost:6333")
vector_store = QdrantVectorStore(client=qdrant_client, collection_name="drocuments")

# 2 Load Documents and Apply Semantic Chunking (Best for RAG)
# Use an LLM-powered approach to split based on semantic meaning, keeping related concepts together.
documents = SimpleDirectoryReader("./ai/scripts/files").load_data()
splitter = TokenTextSplitter(chunk_size=512, chunk_overlap=50)
nodes = splitter.get_nodes_from_documents(documents)

# 3 Create Index and Store in Qdrant
storage_context = StorageContext.from_defaults(vector_store=vector_store)
index = VectorStoreIndex(nodes, storage_context=storage_context)

