{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "profile_digest",
    "binding",
    "sources",
    "context",
    "local_only"
  ],
  "properties": {
    "protocol": {
      "const": "selene.recognition/0.1.0"
    },
    "profile_digest": {
      "const": "64b40ea0957964bb4ff23643457284e6ebefbebbe9be4d7b822f0a3c62bca837"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weave_action_run_id",
        "execution_action_run_id",
        "attempt_id",
        "revision",
        "source_digest",
        "context_revision",
        "context_digest",
        "contract_version",
        "prompt_version",
        "strategy_id",
        "strategy_version",
        "steps_digest",
        "bundle_digest",
        "reference_fields_digest",
        "step_id",
        "step_version",
        "input_digest"
      ],
      "properties": {
        "weave_action_run_id": {
          "type": "string",
          "format": "uuid"
        },
        "execution_action_run_id": {
          "type": "string",
          "format": "uuid"
        },
        "attempt_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "source_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "context_revision": {
          "type": "integer",
          "minimum": 0
        },
        "context_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contract_version": {
          "const": "0.1.0"
        },
        "prompt_version": {
          "const": "0.1.0"
        },
        "strategy_id": {
          "const": "writing.fiction_note_recognition"
        },
        "strategy_version": {
          "const": "0.1.0"
        },
        "steps_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bundle_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reference_fields_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "step_id": {
          "const": "mention_recognition"
        },
        "step_version": {
          "const": "0.1.0"
        },
        "input_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_ref",
          "source_revision",
          "text"
        ],
        "properties": {
          "source_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "source_revision": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      },
      "minItems": 1,
      "maxItems": 12
    },
    "context": {
      "type": "object",
      "required": [
        "revision",
        "folio_id",
        "work_type",
        "bundle"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "folio_id": {
          "type": "string",
          "format": "uuid"
        },
        "work_type": {
          "const": "fiction"
        },
        "bundle": {
          "type": "object",
          "required": [
            "digest"
          ],
          "properties": {
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "local_only": {
      "const": true
    }
  }
}
