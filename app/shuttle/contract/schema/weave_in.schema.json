{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mixtape.internal/shuttle/contract/weave_in.schema.json",
  "title": "Shuttle Weave (in)",
  "description": "The person's words, verbatim, that start one weave. ADR-0058 D1, D2.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "text", "client", "capture_mode"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "text": {
      "type": "string",
      "description": "The weave, verbatim. The agent never smooths or drafts this (D3).",
      "minLength": 1
    },
    "client": {
      "type": "string",
      "enum": ["phone", "desktop"]
    },
    "capture_mode": {
      "type": "string",
      "enum": ["typed", "voice"]
    }
  }
}
