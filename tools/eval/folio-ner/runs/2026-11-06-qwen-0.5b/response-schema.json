{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "label",
    "evidence",
    "uncertain"
  ],
  "properties": {
    "decision": {
      "enum": [
        "classified",
        "abstained"
      ]
    },
    "label": {
      "enum": [
        "writing.character",
        "writing.setting",
        "writing.scene",
        "none",
        null
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "quote",
          "occurrence"
        ],
        "properties": {
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "occurrence": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "uncertain": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    }
  }
}
