DJANGO_ENV=dev

# ============================================================================
# JWT TOKEN SECRETS (Set both - they serve different purposes!)
# ============================================================================

# LIVEWIRE_JWT_SECRET
# Purpose: Secure WebSocket handshake tokens for Socket.IO connections
# Flow:
#   1. Frontend requests WS token from Django (/api/livewire/token)
#   2. Django mints token signed with LIVEWIRE_JWT_SECRET
#   3. Frontend connects to Socket.IO server with this token
#   4. Livewire server validates token using same secret
# Security: Must match between Django and livewire Socket.IO server
# Example: openssl rand -hex 32
LIVEWIRE_JWT_SECRET=your-livewire-secret-here

# SERVICE_JWT_SECRET
# Purpose: Secure service-to-service API calls (Livewire → Django)
# Flow:
#   1. Livewire receives WS token from client
#   2. Livewire exchanges WS token for SERVICE token (/api/livewire/exchange)
#   3. Django mints short-lived (10min) service token signed with SERVICE_JWT_SECRET
#   4. Livewire uses service token to call Django APIs on behalf of user
# Security: MUST be different from LIVEWIRE_JWT_SECRET
# Example: openssl rand -hex 32
SERVICE_JWT_SECRET=your-service-secret-here

# ============================================================================
# Why two secrets?
# - Separation of concerns: Client auth vs service auth
# - Different lifespans: WS tokens (30min) vs Service tokens (10min)
# - If one is compromised, the other remains secure
# ============================================================================

# ARIADNE_PUBLISH_JWT_SECRET
# Purpose: Cass-to-Crossroads Ariadne Review publish flow (its own secret,
# NEVER SERVICE_JWT_SECRET -- that one secret verifies every internal
# service token, so a copy on Cass would let anyone there mint a
# production token for any service and scope).
# Flow:
#   1. A person runs `ariadne_publish_review` on Cass to publish one
#      accessioned Review
#   2. The command mints a short-lived (5min) token signed with
#      ARIADNE_PUBLISH_JWT_SECRET, aud/iss set by ARIADNE_PUBLISH_JWT_AUD/
#      ARIADNE_PUBLISH_JWT_ISS
#   3. Crossroads' ReviewImportView (ariadne/auth.py's
#      AriadnePublishAuthentication) verifies against the same three
#      settings only
# Security: only set on Cass and Crossroads, nowhere else. Held only by
# those two machines (decisions/ariadne/
# build-plan-cass-to-crossroads-result-flow.md). Unset means the import
# endpoint refuses every request -- it never falls back to
# SERVICE_JWT_SECRET. ST-9 (puddlejump zz/build-plan-service-trust.md)
# will fold this into one token-minting module later.
# Example: openssl rand -hex 32
ARIADNE_PUBLISH_JWT_SECRET=your-ariadne-publish-secret-here
# ARIADNE_PUBLISH_JWT_ISS=cass-ariadne
# ARIADNE_PUBLISH_JWT_AUD=crossroads-ariadne-import
# ARIADNE_PUBLISH_JWT_TTL_SECONDS=300

# CROSSROADS_BASE_URL
# Purpose: where `ariadne_publish_review` POSTs the export package.
# Only set on Cass; unused on Crossroads itself.
# CROSSROADS_BASE_URL=https://crossroads.place
