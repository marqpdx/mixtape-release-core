DJANGO_ENV=dev

# ============================================================================
# JWT TOKEN SECRETS (Set both - they serve different purposes!)
# ============================================================================

# LIVEWIRE_JWT_SECRET
# Purpose: Secure WebSocket handshake tokens for Socket.IO connections
# Flow:
#   1. Frontend requests WS token from Django (/api/livewire/token)
#   2. Django mints token signed with LIVEWIRE_JWT_SECRET
#   3. Frontend connects to Socket.IO server with this token
#   4. Livewire server validates token using same secret
# Security: Must match between Django and livewire Socket.IO server
# Example: openssl rand -hex 32
LIVEWIRE_JWT_SECRET=your-livewire-secret-here

# SERVICE_JWT_SECRET
# Purpose: Secure service-to-service API calls (Livewire → Django)
# Flow:
#   1. Livewire receives WS token from client
#   2. Livewire exchanges WS token for SERVICE token (/api/livewire/exchange)
#   3. Django mints short-lived (10min) service token signed with SERVICE_JWT_SECRET
#   4. Livewire uses service token to call Django APIs on behalf of user
# Security: MUST be different from LIVEWIRE_JWT_SECRET
# Example: openssl rand -hex 32
SERVICE_JWT_SECRET=your-service-secret-here

# ============================================================================
# Why two secrets?
# - Separation of concerns: Client auth vs service auth
# - Different lifespans: WS tokens (30min) vs Service tokens (10min)
# - If one is compromised, the other remains secure
# ============================================================================
