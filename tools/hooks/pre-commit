#!/bin/bash
# pre-commit — refuse a commit that adds a secret literal (CTO, 2026-11-17).
#
# Runs tools/check_secret_literals.py on the staged content of this commit and
# BLOCKS it on a match. Output is file:line and the rule only, never the value.
# CI (.github/workflows/secret-literals.yml) checks the whole tree on every push.
# Bypass for a known false positive: `git commit --no-verify`, then add an
# allowance with its reason to tools/secret-literals.toml.
#
# Install: tools/install-hooks.sh (once per clone).

ROOT="$(git rev-parse --show-toplevel)"
PY="$(command -v python3)"
if [ -z "$PY" ]; then
  echo "secret-literals: python3 not found; check skipped (CI still runs it)." >&2
  exit 0
fi
exec "$PY" "$ROOT/tools/check_secret_literals.py" --staged
