@@ -0,0 +1,60 @@
+id: writing.fiction_note_recognition
+version: 0.1.0
+status: draft
+domain: writing
+source_shapes: []
+source_note: Exact captured FolioNote sources and append-only corrections in an explicitly selected Fiction Folio; capture is not a Shape.
+primary_target: null
+secondary_targets:
+- writing.character
+- writing.setting
+targets_note: Character and Setting are equal review buckets; raw candidates are not canonical Sightings. Scene passage selection follows separately.
+operator_intent: Return bare recognition evidence and this Folio's confirmed-name suggestions so the writer can select, correct and explicitly confirm them.
+sectioning: whole_document
+extraction_grain: whole_note
+token_posture: bounded_note_and_explicit_context
+steps:
+- {id: source_context_preparation, kind: deterministic}
+- {id: cue_recognition, kind: deterministic}
+- {id: mention_recognition, kind: model, backend: local, model_calls: 1}
+- {id: checked_recognition, kind: deterministic}
+coverage:
